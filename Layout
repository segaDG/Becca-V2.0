/* ============================================
   BECCA V2.0 — Layout CSS
   App shell: sidebar, header, content area
   ============================================ */

/* === APP SHELL === */
#app {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* === SIDEBAR === */
#sidebar {
  width: var(--sidebar-w);
  flex-shrink: 0;
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  transition: width var(--t-slow);
  z-index: 100;
}

#sidebar.collapsed { width: 56px; }

/* Sidebar Brand */
.sidebar-brand {
  display: flex;
  align-items: center;
  gap: var(--s3);
  padding: 0 var(--s4);
  height: var(--header-h);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.sidebar-logo {
  width: 32px; height: 32px;
  background: var(--primary);
  border-radius: var(--r-md);
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 14px; color: white;
  flex-shrink: 0;
}
.sidebar-name {
  font-weight: 700;
  font-size: 15px;
  color: var(--heading);
  white-space: nowrap;
  overflow: hidden;
  transition: opacity var(--t-slow);
}
#sidebar.collapsed .sidebar-name { opacity: 0; pointer-events: none; }

/* Sidebar Nav */
.sidebar-nav {
  flex: 1;
  overflow-y: auto;
  padding: var(--s3) 0;
}
.sidebar-section {
  padding: var(--s3) var(--s4) var(--s1);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-3);
  white-space: nowrap;
  overflow: hidden;
  transition: opacity var(--t-slow);
}
#sidebar.collapsed .sidebar-section { opacity: 0; }

.nav-item {
  display: flex;
  align-items: center;
  gap: var(--s3);
  padding: 9px var(--s4);
  cursor: pointer;
  border-radius: 0;
  transition: all var(--t-base);
  color: var(--text-2);
  font-size: 13.5px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  border-left: 3px solid transparent;
  position: relative;
}
.nav-item:hover {
  background: var(--surface2);
  color: var(--text);
}
.nav-item.active {
  background: var(--primary-bg);
  color: var(--primary-h);
  border-left-color: var(--primary);
}
.nav-item .nav-icon {
  width: 18px; height: 18px;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.nav-item .nav-label {
  transition: opacity var(--t-slow);
  overflow: hidden;
}
#sidebar.collapsed .nav-item .nav-label { opacity: 0; }

/* Sidebar Footer */
.sidebar-footer {
  padding: var(--s3) var(--s4);
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}
.sidebar-user {
  display: flex; align-items: center; gap: var(--s3);
  padding: var(--s2) 0;
  overflow: hidden;
}
.user-avatar {
  width: 32px; height: 32px;
  border-radius: var(--r-full);
  background: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 700; color: white;
  flex-shrink: 0;
}
.user-info { overflow: hidden; }
.user-name  { font-size: 13px; font-weight: 600; color: var(--heading); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-role  { font-size: 11px; color: var(--text-3); }
#sidebar.collapsed .user-info { opacity: 0; }

/* === MAIN AREA === */
#main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
}

/* === HEADER === */
#header {
  height: var(--header-h);
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--s6);
  flex-shrink: 0;
  gap: var(--s4);
}
.header-left {
  display: flex; align-items: center; gap: var(--s3);
}
.header-right {
  display: flex; align-items: center; gap: var(--s2);
}
#btn-toggle-sidebar {
  width: 32px; height: 32px;
  border-radius: var(--r-sm);
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-2);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all var(--t-base);
}
#btn-toggle-sidebar:hover { background: var(--surface2); color: var(--text); border-color: var(--border); }

.page-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--heading);
}
.page-subtitle {
  font-size: 12px;
  color: var(--text-3);
  margin-left: var(--s2);
}

/* Header Icon Buttons */
.header-btn {
  width: 34px; height: 34px;
  border-radius: var(--r-sm);
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-2);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all var(--t-base);
  position: relative;
}
.header-btn:hover { background: var(--surface2); color: var(--text); }
.notif-badge {
  position: absolute;
  top: 4px; right: 4px;
  width: 7px; height: 7px;
  background: var(--danger);
  border-radius: var(--r-full);
  border: 1.5px solid var(--surface);
}

/* === CONTENT === */
#content {
  flex: 1;
  overflow-y: auto;
  padding: var(--s6);
}

/* Page sections */
.page { display: none; }
.page.active { display: block; animation: pageIn 0.2s ease; }
@keyframes pageIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Page Header */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--s6);
  flex-wrap: wrap;
  gap: var(--s3);
}
.page-header-left h2 { margin-bottom: 2px; }
.page-header-left p  { font-size: 13px; }
.page-header-right   { display: flex; align-items: center; gap: var(--s2); }

/* === SUB-TABS === */
.tabs {
  display: flex;
  gap: 2px;
  background: var(--surface2);
  border-radius: var(--r-md);
  padding: 3px;
  width: fit-content;
  margin-bottom: var(--s5);
}
.tab-btn {
  padding: 6px 14px;
  border-radius: var(--r-sm);
  background: transparent;
  border: none;
  color: var(--text-2);
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--t-base);
  white-space: nowrap;
  font-family: var(--font);
}
.tab-btn:hover  { color: var(--text); }
.tab-btn.active { background: var(--surface); color: var(--heading); font-weight: 600; box-shadow: var(--shadow-sm); }

/* === GRID LAYOUTS === */
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4); }
.grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--s4); }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s4); }

@media (max-width: 1200px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 900px)  { .grid-3 { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px)  {
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  #content { padding: var(--s4); }
  #sidebar  { position: fixed; transform: translateX(-100%); }
  #sidebar.mobile-open { transform: translateX(0); }
}

/* === LOGIN PAGE === */
#page-login {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
  padding: var(--s6);
}
.login-card {
  width: 100%;
  max-width: 400px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--s8);
  box-shadow: var(--shadow-lg);
}
.login-brand {
  display: flex; align-items: center; gap: var(--s3);
  margin-bottom: var(--s8);
}
.login-logo {
  width: 44px; height: 44px;
  background: var(--primary);
  border-radius: var(--r-lg);
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 18px; color: white;
}
.login-title { font-size: 18px; font-weight: 700; }
.login-sub   { font-size: 12px; color: var(--text-3); }
