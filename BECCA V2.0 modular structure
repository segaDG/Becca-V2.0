<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="BECCA — Catering Order System v2.0">
  <title>BECCA — Catering System</title>

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%236366f1'/><text y='23' x='6' font-size='20' font-weight='800' fill='white' font-family='Arial'>B</text></svg>">

  <!-- CSS (urutan penting!) -->
  <link rel="stylesheet" href="css/base.css">
  <link rel="stylesheet" href="css/layout.css">
  <link rel="stylesheet" href="css/components.css">
  <link rel="stylesheet" href="css/tables.css">
</head>
<body>

  <!-- ==================== LOGIN PAGE ==================== -->
  <div id="page-login" class="hidden"></div>

  <!-- ==================== APP SHELL ==================== -->
  <div id="app" class="hidden">

    <!-- Sidebar -->
    <aside id="sidebar"></aside>

    <!-- Main Area -->
    <div id="main">

      <!-- Header -->
      <header id="header"></header>

      <!-- Content -->
      <main id="content">

        <!-- Dashboard -->
        <section id="page-dashboard" class="page"></section>

        <!-- Order -->
        <section id="page-order" class="page"></section>

        <!-- Invoice -->
        <section id="page-invoice" class="page"></section>

        <!-- Customer -->
        <section id="page-customer" class="page"></section>

        <!-- Karyawan -->
        <section id="page-employee" class="page"></section>

        <!-- Inventory -->
        <section id="page-inventory" class="page"></section>

        <!-- Kas Kecil -->
        <section id="page-kas" class="page"></section>

        <!-- Account Payable -->
        <section id="page-ap" class="page"></section>

        <!-- Task -->
        <section id="page-task" class="page"></section>

        <!-- Laporan -->
        <section id="page-report" class="page"></section>

        <!-- Pengaturan -->
        <section id="page-settings" class="page"></section>

      </main>
    </div>
  </div>

  <!-- Modal Root -->
  <div id="modal-root"></div>

  <!-- Toast Root -->
  <div id="toast-root"></div>

  <!-- ==================== SCRIPTS ==================== -->

  <!-- Firebase (opsional — hapus jika tidak pakai) -->
  <!-- <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script> -->
  <!-- <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore-compat.js"></script> -->

  <!-- 1. Core (load pertama) -->
  <script src="js/utils.js"></script>
  <script src="js/db.js"></script>
  <script src="js/auth.js"></script>

  <!-- 2. UI Components -->
  <script src="js/ui/notify.js"></script>
  <script src="js/ui/modal.js"></script>
  <script src="js/ui/sidebar.js"></script>

  <!-- 3. Feature Modules -->
  <script src="js/modules/dashboard.js"></script>
  <script src="js/modules/order.js"></script>
  <!-- Tambah modul baru di sini sebelum app.js -->

  <!-- 4. App Init (load terakhir) -->
  <script src="js/app.js"></script>

</body>
</html>
